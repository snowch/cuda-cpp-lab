      "id": "s01",
      "start": 0.0,
      "end": 12.892,
      "title": "What is a CUDA kernel?"
    },
    {
      "id": "s02",
      "start": 12.892,
      "end": 28.152,
      "title": "Launch one thread"
    },
    {
      "id": "s03",
      "start": 28.152,
      "end": 43.519,
      "title": "Where does the value go?"
    },
    {
      "id": "s04",
      "start": 43.519,
      "end": 54.277,
      "title": "Change the stored value"
    }
  ],
  "cues": [
    {
      "id": "s01-c1",
      "start": 0.6,
      "end": 4.632,
      "text": "A CUDA kernel is a function that GPU threads execute."
    },
    {
      "id": "s01-c2",
      "start": 4.852,
      "end": 7.583,
      "text": "In this file, global marks hello as a kernel."
    },
    {
      "id": "s01-c3",
      "start": 7.803,
      "end": 11.472,
      "text": "The thread writes forty-two point zero at output index zero."
    },
    {
      "id": "s02-c1",
      "start": 13.492,
      "end": 18.079,
      "text": "On the CPU, main reserves space in GPU memory for one float."
    },
    {
      "id": "s02-c2",
      "start": 18.299,
      "end": 23.056,
      "text": "The first one requests one block. The second one requests one thread in that block."
    },
    {
      "id": "s02-c3",
      "start": 23.276,
      "end": 26.732,
      "text": "The argument output gives the kernel the address of the float."
    },
    {
      "id": "s03-c1",
      "start": 28.752,
      "end": 34.085,
      "text": "A streaming multiprocessor, or S M, executes instructions for the GPU thread."
    },
    {
      "id": "s03-c2",
      "start": 34.305,
      "end": 37.932,
      "text": "The kernel stores forty-two point zero in GPU memory."
    },
    {
      "id": "s03-c3",
      "start": 38.152,
      "end": 42.099,
      "text": "The CPU copies the value back, and main prints it in the console."
    },
    {
      "id": "s04-c1",
      "start": 44.119,
      "end": 47.767,
      "text": "Change the value in the assignment, then compile and run again."
    },
    {
      "id": "s04-c2",
      "start": 47.987,
      "end": 50.717,
      "text": "The launch still asks for one block and one thread."
    },
    {
      "id": "s04-c3",
      "start": 50.937,
      "end": 52.857,
      "text": "Which value will main print this time?"
    }
  ],
